<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd 
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<sub-flow name="main-process-subflow" doc:id="a391fb68-8ed1-4d96-9d8b-7b905c7540e1" >
		<scatter-gather doc:name="Scatter-Gather" doc:id="c895b505-de5b-4241-98d1-217a7bf388a8" >
			<route >
				<async doc:name="Async" doc:id="b60dc76e-4d03-4370-b744-0c5190def2b5" >
					<try doc:name="Try" doc:id="0724c7b6-66a7-43f2-932e-a239a54f063c">
					<db:insert doc:name="Insert Signal" doc:id="dfc53281-0ca8-4684-8008-1a5df506312d" config-ref="Database_Config" autoGenerateKeys="true" autoGeneratedKeysColumnNames="#[['id']]" target="dbId" targetValue="#[payload.generatedKeys.id as String]">
			<error-mapping targetType="DATABASE:INSERT_SIGNAL" />
						<db:sql><![CDATA[INSERT INTO signals (signal, ticker, interval, time, exchange, open, high, low, close)
VALUES (
  :signal,
  :ticker,
  :interval,
  :time,
  :exchange,
  :open,
  :high,
  :low,
  :close
)]]></db:sql>
			<db:input-parameters><![CDATA[#[{
  signal: payload.signal,
  ticker: payload.ticker,
  time: payload.time as DateTime,
  exchange: payload.exchange,
  interval: payload.candle.interval,
  open: payload.candle.open,
  high: payload.candle.high,
  low: payload.candle.low,
  close: payload.candle.close
}]]]></db:input-parameters>
			<db:auto-generated-keys-column-indexes />
		</db:insert>
					<error-handler ref="database-error-handler" />
				</try>
				</async>
			</route>
			<route >
				<try doc:name="Try" doc:id="51f87901-3f83-474d-b25d-7e26771de15a" >
					<flow-ref doc:name="Get User Balance" doc:id="70f2e055-8ec7-4eb0-a351-ca8776d65537" name="get-user-balance" />
					<error-handler ref="get-user-balance-error-handler" />
				</try>
			</route>
			<route >
				<try doc:name="Try" doc:id="22604fa5-b644-4e68-9d74-af6f780f2898" >
					<flow-ref doc:name="Get Ticker Price" doc:id="f4f0c67d-8093-4eaf-ad46-bc183dba81a5" name="get-ticker-price" />
					<error-handler ref="get-ticker-price-error-handler" />
				</try>
			</route>
			<route >
				<try doc:name="Try" doc:id="5399782c-844b-4829-9b01-77a1e59b0019" >
					<flow-ref doc:name="Get Open Orders" doc:id="271d6072-a7c2-4155-abb9-fad536ede26d" name="get-open-orders-subflow" />
					<error-handler ref="get-open-orders-error-handler" />
				</try>
			</route>
			<route >
				<try doc:name="Try" doc:id="58e87af0-5024-4e5c-aa59-1894b7db368d" >
					<flow-ref doc:name="Set Leverage" doc:id="caa056b7-04ef-44f7-b5e7-fe0ec92ea081" name="set-leverage" />
					<error-handler ref="set-leverage-error-handler" />
				</try>
			</route>
		</scatter-gather>
		<set-variable value="#[var pnl = vars.pnl as Number&#10;var fr = if((vars.fundingRate as Number) &gt;= 0) 0 else vars.fundingRate as Number&#10;---&#10;floor(pnl - (pnl * (fr * (-1)))) as String]" doc:name="Set Transf" doc:id="e813d361-3bd1-41d3-ad1b-ff289d5be869" variableName="transf" />
		<choice doc:name="Are there orders Openned?" doc:id="b74033ae-aaef-48d8-8aec-96c0d1b9c4fc" >
			<when expression='#[vars.openOrders.result.list[0].size != "0" and vars.openOrders.result.list[0].side != vars.signal]'>
				<try doc:name="Try" doc:id="38321f97-3d2d-4a7c-b0bc-4157e70c705e" >
					<flow-ref doc:name="Close Orders" doc:id="13d3a373-daec-4bd3-b10f-04674edd0eb9" name="close-orders-subflow" />
					<logger level="INFO" doc:name="Logger" doc:id="2f7644a5-3805-41f4-a9ef-66e65e199bc6" message="Previous Order Closed"/>
					<scatter-gather doc:name="Scatter-Gather" doc:id="81d4eb44-b448-463b-b3b6-221a2120b148">
					<route>
						<async doc:name="Async" doc:id="6c7139a0-2c91-41ec-a40f-17609490b32f" >
								<try doc:name="Try" doc:id="6800d9df-7b78-474c-9605-4045119c6f26">
									<flow-ref doc:name="Transfer Assets Logic" doc:id="3fef51d4-3bdd-47bb-9d45-13402da84ad4" name="transfer-assets-logic-subflow" />
									<error-handler ref="transfer-assets-error-handler" />
						</try>
								<logger level="INFO" doc:name="Logger" doc:id="d63a062e-d2fd-4a51-98d9-3ccac4bb94f9" message="Profit Transfered to Funding Account"/>
								<flow-ref doc:name="Send Closure Email" doc:id="e65db47b-0873-456a-9540-c947d31dc878" name="set-closure-email-subflow" />
							</async>
					</route>
					<route>
						<async doc:name="Async" doc:id="1e6032ae-5660-486f-b587-e8d7599224f0" >
								<try doc:name="Try" doc:id="3c76845a-60d6-418c-bda4-2f9342e93356">
							<db:select doc:name="Select Order" doc:id="2d35c5d5-7cbc-4fd3-97a2-abf47826b2d6" config-ref="Database_Config" target="parentOrderId" targetValue="#[payload[0].id]">
							<error-mapping targetType="DATABASE:SELECT_ORDER" />
								<db:sql><![CDATA[SELECT id FROM orders WHERE side = :side ORDER BY id DESC LIMIT 1]]></db:sql>
							<db:input-parameters><![CDATA[#[{
	side: if(vars.signal == "Sell") "Buy" else "Sell"
}]]]></db:input-parameters>
						</db:select>
							<error-handler ref="database-error-handler" />
						</try>
								<set-variable value='#["closure"]' doc:name="Set Order Role" doc:id="b248ea47-ed1b-4674-a9a2-6e7aa461dc96" variableName="orderRole" />
								<try doc:name="Try" doc:id="8551b0c4-7ebf-4e57-af45-96e4ed222b85">
							<flow-ref doc:name="Insert Order DB" doc:id="cb6f7bcb-4a45-426f-8902-7d8b4ea3ed4f" name="insert-orders-db-subflow" />
							<error-handler ref="database-error-handler" />
						</try>
								<remove-variable doc:name="Remove Parent Order Role" doc:id="4a3b5cbc-ed3b-47e3-a5a7-8d91dc5f34b1" variableName="parentOrderId" />
							</async>
					</route>
				</scatter-gather>
					<error-handler ref="close-orders-error-handler" />
				</try>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="e3626b4c-cdcd-4421-b9bc-67519eea4ff0" message="No orders to be closed"/>
			</otherwise>
		</choice>
		<choice doc:name="Close and Open?" doc:id="f2d3576f-4e04-49e2-b971-08b0397181b5" >
			<when expression='#[vars.signalType == "2"]'>
				<set-variable value="#[var fundingRate = if((vars.fundingRate as Number) &gt;= 0) 0 else vars.fundingRate as Number&#10;var qty = (vars.quoteQty * 0.975) / vars.tickerPrice&#10;var fmt = readUrl('classpath://bybit-qty-steps.json','application/json')&#10;---&#10;(qty - (qty * (fundingRate * (-1)))) as String {format: fmt[vars.ticker], locale: &quot;en&quot;}]" doc:name="Set Order Quantity" doc:id="17a08096-1e91-406f-8d7d-e7d8b664cdb9" variableName="orderQty" />
				<try doc:name="Try" doc:id="7b2f90d7-df61-4793-a640-27c961e9cd7b" >
					<flow-ref doc:name="Create Order" doc:id="a7f4a214-6004-48c0-890f-a9f5be70732f" name="create-order-subflow" />
					<error-handler ref="open-orders-error-handler" />
				</try>
				<logger level="INFO" doc:name="Logger" doc:id="c9e81835-f03b-4a21-9bdc-6fa04f318301" message="New Order Opened"/>
				<flow-ref doc:name="Send Opening Email" doc:id="f7b51f9c-9342-42b8-a14e-12569754e2c8" name="set-opening-email-subflow"/>
			</when>
		</choice>
		<set-variable value='#["opening"]' doc:name="Set Order Role" doc:id="67f8748e-e921-43fc-968e-ebd1cdec4955" variableName="orderRole"/>
		<try doc:name="Try" doc:id="09f821f2-b773-4b54-9ba2-18b2a19ed57e" >
			<flow-ref doc:name="Insert Order DB" doc:id="88ad9bb0-b5c1-4f1e-9a5a-732cb4cafce4" name="insert-orders-db-subflow" />
			<error-handler ref="database-error-handler" />
		</try>
	</sub-flow>
	<sub-flow name="close-orders-subflow" doc:id="e303073b-005a-4802-9c9c-5031f88927bf" >
		<set-variable value="#[vars.openOrders.result.list[0].size]" doc:name="Set Order Quantity" doc:id="9b084d70-74cf-4c5b-828f-c421b87df43c" variableName="orderQty" />
		<set-variable value="#[true]" doc:name="Set Reduce Only" doc:id="dcd5c670-a3d2-41b9-a881-29031bb9e192" variableName="reduceOnly" />
		<set-variable value="#[vars.dbId]" doc:name="Set temp DB Id" doc:id="6cc48779-f8e8-42d4-b223-068d6825363b" variableName="tempDbId" />
		<set-variable value="#[null]" doc:name="Set Db Id" doc:id="93c7da8e-bab6-4b3c-9432-8772ceb5f0b2" variableName="dbId" />
		<flow-ref doc:name="Create Order" doc:id="e8652b8a-2f91-46e8-aa17-1108cfaa8fda" name="create-order-subflow" />
		<remove-variable doc:name="Remove Reduce Only" doc:id="7b4e0ced-6ce0-44cf-8728-4fa7d27ff0b9" variableName="reduceOnly" />
		<set-variable value="#[vars.tempDbId]" doc:name="Set Db Id" doc:id="fc050123-3032-4bb0-933c-1702bbb74e14" variableName="dbId" />
		<remove-variable doc:name="Remove Temp Db Id" doc:id="286927a2-6999-4e20-912b-bc9c57db6b43" variableName="tempDbId" />
	</sub-flow>
	<sub-flow name="set-closure-email-subflow" doc:id="c6281a1d-fa3c-4786-bbcc-050528cad14a" >
		<set-variable value='#[p("notification.email")]' doc:name="Set toEmail" doc:id="ba0dcfa3-8c4a-4816-a43a-746e2da35ff0" variableName="toEmail"/>
		<set-variable value="#[output text/plain&#10;var colour = if((vars.pnl as Number) &gt;= 0) &quot;#1a6b4a&quot; else &quot;#c0392b&quot;&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;SHORT&quot; else &quot;LONG&quot;&#10;var dt = now() as String {format: 'dd/MMM/yyyy HH:mm:ss'}&#10;var transf = if (vars.transf &gt; 0) vars.transf as String ++ vars.quoteCoin else &quot;---&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; background-color: #f5f5f5; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;A closure order has been executed&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #1a6b4a;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #1a3a5c;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #c9a84c; text-align: center;&quot;&gt;Order Details&lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Asset&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ vars.ticker ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #f9f9f9;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Side&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ signal ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #f9f9f9;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Date and Time&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ dt ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #f9f9f9;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Realized PnL&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color:' ++ colour ++ '; font-weight: bold; text-align: right;&quot;&gt;' ++ vars.pnl ++ &quot; &quot; ++ vars.quoteCoin ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; color: #1a3a5c; font-weight: bold;&quot;&gt;Amount Transfered to Fund&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; color: #c9a84c; font-weight: bold; text-align: right;&quot;&gt;' ++ transf ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c; font-size: 12px; margin-top: 24px;&quot;&gt;Argus Strategy — automated order system &lt;em&gt;(by BRX)&lt;/em&gt;&lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;']" doc:name="Set mailBody" doc:id="267905fd-4ea4-439e-b62a-00def9790000" variableName="mailBody"/>
		<set-variable value="text/html" doc:name="Set Content Type" doc:id="43e67622-2375-4efd-b3e1-69ca8db7d8e6" variableName="contentType"/>
		<set-variable value='#["[BRX] Closure Order Report | " ++ vars.ticker]' doc:name="Set Subject" doc:id="338702ef-5c53-4340-87c8-61bafff30d87" variableName="subject"/>
		<flow-ref doc:name="Send Email" doc:id="7ee4734f-cb1b-49ba-b37c-ee323fa03ca9" name="send-email-subflow"/>
		<remove-variable doc:name="Remove mailBody" doc:id="c9f56a11-f819-441c-b767-d2708dd049b0" variableName="mailBody"/>
		<remove-variable doc:name="Remove Subject" doc:id="bb6fa3c6-1652-4af8-a70b-bbb506739208" variableName="subject"/>
	</sub-flow>
	<sub-flow name="set-opening-email-subflow" doc:id="742f7cb0-9ffe-41e6-b846-cd4038615303">
		<set-variable value="#[output text/plain&#10;var colour = if((vars.pnl as Number) &gt;= 0) &quot;#1a6b4a&quot; else &quot;#c0392b&quot;&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;SHORT&quot; else &quot;LONG&quot;&#10;var dt = now() as String {format: 'dd/MMM/yyyy HH:mm:ss'}&#10;var transf = if (vars.transf &gt; 0) vars.transf as String ++ vars.quoteCoin else &quot;---&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;An opening order has been executed&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #1a6b4a;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #1a3a5c;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #c9a84c; text-align: center;&quot;&gt;Order Details&lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Asset&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ vars.ticker ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #f9f9f9;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Side&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ signal ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;        &lt;tr style=&quot;background-color: #f9f9f9;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; color: #1a3a5c; font-weight: bold;&quot;&gt;Date and Time&lt;/td&gt;&#10;            &lt;td style=&quot;padding: 10px; border-bottom: 1px solid #e0e0e0; text-align: right;&quot;&gt;' ++ dt ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c; font-size: 12px; margin-top: 24px;&quot;&gt;Argus Strategy — automated order system &lt;em&gt;(by BRX)&lt;/em&gt;&lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;']" doc:name="Set mailBody" doc:id="f4a3ba2b-24bc-4287-9316-3721b46abd60" variableName="mailBody" />
		<set-variable value="text/html" doc:name="Set Content Type" doc:id="e53f106f-e630-4d34-8593-0418dfecedc7" variableName="contentType" />
		<set-variable value='#[p("notification.email")]' doc:name="Set toEmail" doc:id="9ec24713-bbbe-407d-a497-4ee35b027146" variableName="toEmail" />
		<set-variable value='#["[BRX] Opening Order Report | " ++ vars.ticker]' doc:name="Set Subject" doc:id="ade2a3b4-a3bd-48e3-a17f-57054cdfb62f" variableName="subject" />
		<flow-ref doc:name="Send Email" doc:id="4edafbf8-a615-4254-b983-2106c9f5bb57" name="send-email-subflow" />
		<remove-variable doc:name="Remove mailBody" doc:id="ed65e189-19d0-472d-8d82-70c14c7030da" variableName="mailBody" />
		<remove-variable doc:name="Remove Subject" doc:id="3259ca33-b306-49b7-8002-42d5487c3004" variableName="subject" />
	</sub-flow>
	<sub-flow name="transfer-assets-logic-subflow" doc:id="34d1207c-ed0c-422e-9df7-522a7efb0a22" >
		<choice doc:name="Choice" doc:id="6c6822da-4a35-4418-9e7e-41cbe2625cfb" >
			<when expression="#[(vars.pnl as Number) &gt; 0]">
				<flow-ref doc:name="Transfer Assets" doc:id="34105793-4b3a-41b9-a195-dd23e6ae5411" name="transfer-assets-subflow" />
			</when>
		</choice>
	</sub-flow>
</mule>
