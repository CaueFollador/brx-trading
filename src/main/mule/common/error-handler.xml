				<set-variable value='#["Your current signal failed to be insert in our database. Please contact support with this ID: " ++ correlationId ++ " | " ++ now()]' doc:name="Set mailBody" doc:id="396d1473-ec90-417c-b77a-9c41be0f3bbe" variableName="mailBody" />
