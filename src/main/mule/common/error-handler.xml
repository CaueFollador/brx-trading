	<error-handler name="get-user-balance-error-handler" doc:id="34210142-35c2-46e6-b57d-13ecda920067" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="5842c796-7d98-4634-886e-15ea8ad0f8a7" >
			<logger level="ERROR" doc:name="Logger" doc:id="cf8fa66c-9d9c-4068-96bb-f36894aa03cd" message="Failed to get User balance"/>
			<set-variable value='#["🔴 [BRX] Error - Consult User Balance | " ++ vars.ticker]' doc:name="Set Subject" doc:id="84865a98-9f5b-4123-a630-4c676b3f3619" variableName="subject" />
			<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to check your balance. Once this is an important step in our execution, the process had to be cancelled and no orders were executed.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="93aa0bbd-a6ee-437c-b284-5ee1a5532c45" variableName="mailBody" />
			<set-variable value="text/html" doc:name="Set Content Type" doc:id="8fb670e8-98c2-482a-a5db-03229d338c33" variableName="contentType"/>
			<flow-ref doc:name="Prepare Email" doc:id="8724a2ee-2fe3-485b-aa33-d447ec47ee12" name="prepare-error-email" />
		</on-error-propagate>
	</error-handler>
	<error-handler name="get-ticker-price-error-handler" doc:id="a85d6021-7f95-4ae4-b1c4-c1af1cfeae76" >
