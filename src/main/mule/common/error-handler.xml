			<set-variable value='#["🔴 [BRX] Error - Consult Pair Price | " ++ vars.ticker]' doc:name="Set Subject" doc:id="17b0b1d2-4932-41d0-8f7a-81d90e50f8d9" variableName="subject" />
			<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to check' ++ vars.ticker ++ ' pair price. Once this is an important step in our execution, the process had to be cancelled and no orders were executed.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="323c6464-3543-405a-b3cb-b6cb816dd1c5" variableName="mailBody" />
			<set-variable value="text/html" doc:name="Set Content Type" doc:id="a1561351-a867-4b28-83c4-8c3eed81fc46" variableName="contentType" />
			<flow-ref doc:name="Prepare Email" doc:id="c5efe731-5906-4f62-808b-de44d6f1a426" name="prepare-error-email" />
		</on-error-propagate>
	</error-handler>
	<error-handler name="get-open-orders-error-handler" doc:id="64880949-193c-41c8-9ecf-722497cae47c" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="6bc5d44f-697b-40a6-b287-8c4ef4ddd37b" >
			<logger level="ERROR" doc:name="Logger" doc:id="89ae3594-b65d-4723-8d11-02d8355800bc" message="Failed to check for Open Orders" />
			<set-variable value='#["🔴 [BRX] Error - Consult Open Orders | " ++ vars.ticker]' doc:name="Set Subject" doc:id="d986ae68-fc49-4d38-b9b0-1b5352d04d6e" variableName="subject" />
			<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;Long&quot; else &quot;Short&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to consult your ' ++ vars.ticker ++ ' open order. Once this is an important step in our execution, the process had to be cancelled and no orders were executed.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="f44337c6-0f74-4044-8ce0-40eef8b4a545" variableName="mailBody" />
			<set-variable value="text/html" doc:name="Set Content Type" doc:id="ff9c030e-219a-4791-91ca-2b505d205169" variableName="contentType" />
			<flow-ref doc:name="Prepare Email" doc:id="30d7391f-d8a1-41f0-9e4c-8aeed88b522f" name="prepare-error-email" />
		</on-error-propagate>
	</error-handler>
	<error-handler name="set-leverage-error-handler" doc:id="22a24fcd-f8a7-4bb4-91bb-bfe79b1d20c1" >
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="da1c2884-f550-454a-826b-19053fd2c7d5" >
			<logger level="WARN" doc:name="Logger" doc:id="d43851e5-4a93-4f27-92cd-7d7530a97b1a" message="Failed to set operation leverage" />
			<async doc:name="Async" doc:id="a1e1d169-79cb-4f72-a46f-ffd1101351e1" >
				<set-variable value='#["⚠️ [BRX] Warning - Leverage Not Changed | " ++ vars.ticker]' doc:name="Set Subject" doc:id="82715b2b-be1f-4da5-8863-d3a7e14a9326" variableName="subject" />
				<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;Long&quot; else &quot;Short&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to change the leverage to ' ++ vars.ticker ++ ' pair. Leverage was inherited from your last trade. Please verify the current value on the exchange.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="abbca317-1f91-4149-a69f-c354219bdd8d" variableName="mailBody" />
				<set-variable value="text/html" doc:name="Set Content Type" doc:id="1881268d-0dfd-4778-862c-7923c02e3855" variableName="contentType" />
				<flow-ref doc:name="Prepare Email" doc:id="26ddaf6e-17eb-44c4-aa79-34166b75adc0" name="prepare-error-email" />
			</async>
		</on-error-continue>
	</error-handler>
	<error-handler name="close-orders-error-handler" doc:id="9ccb87d4-9fbc-4bac-956d-6991a8eac13e" >
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="7302ca6f-368f-4b07-8746-eec375125013" >
			<logger level="WARN" doc:name="Logger" doc:id="0ec0953f-fea2-41cb-b7d9-c8dbca5f5cfe" message="Failed to close the latest Order" />
			<async doc:name="Async" doc:id="21d86480-0e8c-4c15-8e52-36a2bdd2d837" >
				<set-variable value='#["⚠️ [BRX] Warning - Order Closure | " ++ vars.ticker]' doc:name="Set Subject" doc:id="474e8e47-0e0a-4188-8875-135f4f4251d5" variableName="subject" />
				<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;Long&quot; else &quot;Short&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to close your ' ++ signal ++ ' order from ' ++ vars.ticker ++ ' pair. We Suggest you to do it manually.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="56a41eb5-2d08-484b-8fa1-3ba2ed10927c" variableName="mailBody" />
				<set-variable value="text/html" doc:name="Set Content Type" doc:id="c042fbdb-4b81-463d-baec-10a77bb184dc" variableName="contentType" />
				<flow-ref doc:name="Prepare Email" doc:id="372d2887-4685-446f-a51a-a1080d260133" name="prepare-error-email" />
			</async>
		</on-error-continue>
	</error-handler>
	<error-handler name="transfer-assets-error-handler" doc:id="8d7ce4cb-d787-44cc-ba2b-574b68bb8c5c" >
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="dcb49ee1-957b-404d-90b1-81e26e017b5c" >
			<logger level="WARN" doc:name="Logger" doc:id="bca1f934-11f1-470a-a8d6-5a5002880be5" message="Failed to transfer assets to Funding Account" />
			<async doc:name="Async" doc:id="17d4e629-e3e0-4701-a40a-d3bac4e4a7ab" >
				<set-variable value='#["⚠️ [BRX] Warning - Transfer Profit to Fund | " ++ vars.ticker]' doc:name="Set Subject" doc:id="8f1ae330-327a-4b2b-8875-b623ac243950" variableName="subject" />
				<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;Long&quot; else &quot;Short&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying transfer your profit to Funding Account. Your balance remains in Unified Trading Account.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="bf7748bd-a580-472f-9917-3dcf434c28d4" variableName="mailBody" />
				<set-variable value="text/html" doc:name="Set Content Type" doc:id="75d821ca-3b7e-4c15-a8a8-7542162b811f" variableName="contentType" />
				<flow-ref doc:name="Prepare Email" doc:id="efcae605-4f62-453f-bc8a-c70ee39d2d51" name="prepare-error-email" />
			</async>
		</on-error-continue>
	</error-handler>
	<error-handler name="open-orders-error-handler" doc:id="b1606f9d-29b2-4b9c-a5c0-a1f85b79f8ea" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="edf1d4c5-152f-4db7-9bfa-afb613100946" >
			<logger level="ERROR" doc:name="Logger" doc:id="e06a5b2c-8572-46f4-8eac-1c9399b4a834" message="Failed to open the new order" />
			<set-variable value='#["🔴 [BRX] Error - Order Opening | " ++ vars.ticker]' doc:name="Set Subject" doc:id="707971b4-9be2-4925-9c8e-976519040cf6" variableName="subject" />
			<set-variable value="#[var errorType = readUrl('classpath://bybit-error-codes.json','application/json')&#10;output text/plain&#10;var signal = if(vars.signal == &quot;Sell&quot;) &quot;Long&quot; else &quot;Short&quot;&#10;---&#10;'&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body style=&quot;font-family: Arial, sans-serif; font-size: 14px; color: #333333; padding: 24px;&quot;&gt;&#10;&#10;&lt;p style=&quot;color: #1a3a5c;&quot;&gt;There was an error while trying to open your ' ++ signal ++ ' order to ' ++ vars.ticker ++ ' pair after several tries.&lt;/p&gt;&#10;&#10;&lt;table border=&quot;0&quot; cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px; width: 400px; border: 2px solid #c0392b;&quot;&gt;&#10;    &lt;thead&gt;&#10;        &lt;tr style=&quot;background-color: #c0392b;&quot;&gt;&#10;            &lt;th colspan=&quot;2&quot; style=&quot;padding: 12px; color: #ffffff; text-align: left;&quot;&gt;&#10;                &lt;strong&gt;Error Detail&lt;/strong&gt;&#10;            &lt;/th&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/thead&gt;&#10;    &lt;tbody&gt;&#10;        &lt;tr style=&quot;background-color: #ffffff;&quot;&gt;&#10;            &lt;td style=&quot;padding: 10px; text-align: center;&quot;&gt;' ++ write(errorType[(payload.retCode as String)],'application/json') ++ '&lt;/td&gt;&#10;        &lt;/tr&gt;&#10;    &lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;']" doc:name="Set mailBody" doc:id="19e6d7db-b543-4e56-aabf-0fe3b0fb82a0" variableName="mailBody" />
			<set-variable value="text/html" doc:name="Set Content Type" doc:id="78a25f09-90f4-46b5-a3a9-8002daace4b1" variableName="contentType" />
			<flow-ref doc:name="Prepare Email" doc:id="7d054286-7ac9-487d-bf8e-cfe867a810ab" name="prepare-error-email" />
		</on-error-propagate>
	</error-handler>
	<sub-flow name="prepare-error-email" doc:id="9c852fb8-afd9-474a-ac94-128601650cb1" >
		<set-variable value='#[p("notification.email")]' doc:name="Set toEmail" doc:id="7d11881c-7c13-4c1e-8f0a-fbd85ce91cdc" variableName="toEmail" />
		<set-variable value='#[vars.contentType default "text/plain"]' doc:name="Set Content Type" doc:id="9fe3dccd-0f1c-4eed-99b4-328a4c639f45" variableName="contentType" />
		<flow-ref doc:name="Send Email" doc:id="26026db1-667b-4cf9-83bc-e5f7bf7f7513" name="send-email-subflow" />
	</sub-flow>

</mule>
