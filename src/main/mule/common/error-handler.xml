				<set-variable value='#["Your current order failed to be insert in our database. Please contact support with this ID: " ++ correlationId ++ " | " ++ now()]' doc:name="Set mailBody" doc:id="d2c25244-94c2-4487-af9b-223184f3da54" variableName="mailBody" />
				<flow-ref doc:name="Prepare Email" doc:id="61ab4186-f693-46d3-bf97-87eb605a3753" name="prepare-error-email" />
			</async>
		</on-error-continue>
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="36dbea45-6225-4233-a119-89efb3f4a4bb" type="DATABASE:SELECT_ORDER" >
			<logger level="WARN" doc:name="Logger" doc:id="5b76413b-1910-44b6-8661-373df67a69e8" message="Failed to retrieve Order ID from Database"/>
